    "cross-env": "10.1.0",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "lightningcss": "1.33.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "patch-package": "8.0.1",
    "prettier": "3.9.10",
